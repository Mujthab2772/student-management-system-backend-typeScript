generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  age       Int
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  marks       Mark[]
}

model Teacher {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  subject   String
  salary    Float
  createdAt DateTime @default(now())

  courses Course[]
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  code        String   @unique
  description String
  createdAt   DateTime @default(now())

  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  enrollments Enrollment[]
  marks       Mark[]
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  studentId Int
  courseId  Int

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model Mark {
  id Int @id @default(autoincrement())

  score Float
  grade String

  createdAt DateTime @default(now())

  studentId Int
  courseId  Int

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
}
