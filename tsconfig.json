{
  
  "compilerOptions": {
    
    "rootDir": "./",
    "outDir": "./dist",

    
    "module": "commonjs",
    "target": "es2020",
    

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    
    "strict": true,
    
    "skipLibCheck": true,

    "moduleResolution": "node"
  },

  "include": ["src"],

  "exclude": ["node_modules", "dist"]
}
